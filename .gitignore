# Секреты. Инвариант 7: реальные значения только в переменных окружения.
.env
.env.*
!.env.example

# Зависимости и сборка
node_modules/
dist/
dist-types/
# Сборка модуля рендера в JS для scripts/render-budget.mjs
# (apps/web/tsconfig.render.json). Появилась в M2a, а строка здесь — нет,
# и каталог всплывал как неотслеживаемый у каждого, кто гонял замер.
dist-render/
build/
*.tsbuildinfo

# Локальная БД для проверки срезов (см. scripts/local-db.sh)
.localdb/

# Инструменты и мусор ОС
coverage/
.vite/
.DS_Store
*.log

# Иконки: исходники PNG кладёт человек, WebP генерирует
# scripts/process-assets.mjs. Готовые файлы коммитятся (ART-BIBLE §5),
# а вот мусор от экспериментов — нет.
assets-src/**/*.psd
assets-src/**/*.ai
