{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "types": [],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "index.ts",
    "assets.ts",
    "render.ts",
    "balance.json",
    "assets.json",
    "palette.json",
    "rigs/*.json",
    "animations.json"
  ],
  "exclude": ["__tests__/**"],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
